# Copy to .env.local for running on your own computer. On Vercel, put these in
# Project → Settings → Environment Variables instead (never commit real values).

# ----- The app -----
# The full address people use, e.g. https://app.yourclubapp.co.nz (https is required in production)
APP_URL=http://localhost:3000
PLATFORM_NAME=Club App
# Monthly price per club in NZD (or set PLATFORM_PRICE_ID to a Price you made in Stripe)
PLATFORM_PRICE_NZD=49
PLATFORM_PRICE_ID=
# Default one-off set-up fee for new clubs in NZD (0 = none). You can also set one per club.
PLATFORM_SETUP_FEE_NZD=0
OWNER_CONTACT=you@yourdomain.co.nz
SIGNUP_OPEN=true

# ----- Secrets (run: npm run gen-key) -----
# Encrypts children's contact and medical details. Keep a copy in your password manager:
# if it's lost, those details can't be recovered.
APP_ENCRYPTION_KEY=
# Lets Vercel Cron run the daily clean-up
CRON_SECRET=
# One-time code to create your owner account at /#/setup. Remove it once you've signed in.
OWNER_SETUP_SECRET=

# ----- Supabase (Project Settings → API Keys, and Connect → Connection string) -----
SUPABASE_URL=https://your-project-ref.supabase.co
# A secret key (starts with sb_secret_). Server only: never share it or put it in the browser.
# The legacy service_role key won't work: only the new keys can pass on each visitor's address.
SUPABASE_SECRET_KEY=
# Transaction pooler connection string (port 6543), with your database password filled in
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# ----- Email (one of these; required in production) -----
# Free: send through a Gmail account using a Google "app password" (about 500 emails a day).
# Google Account → Security → 2-Step Verification (turn on) → App passwords → create one.
GMAIL_USER=yourclubapp@gmail.com
GMAIL_APP_PASSWORD=
# The name people see the email come from (Gmail always uses the Gmail address itself)
EMAIL_FROM=Club App <noreply@yourdomain.co.nz>
# Or Resend / Postmark, which need EMAIL_FROM at a domain you own and have verified
RESEND_API_KEY=
POSTMARK_TOKEN=
# Or any other mail server: SMTP_HOST, SMTP_PORT (465), SMTP_USER, SMTP_PASS

# ----- Stripe (optional until you take payments) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
